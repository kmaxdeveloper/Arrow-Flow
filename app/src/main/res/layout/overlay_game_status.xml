<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Game Over Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlayGameOver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_lose"
        android:elevation="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivGameOverIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/brand_red"
            android:contentDescription="@string/game_over"
            app:layout_constraintBottom_toTopOf="@id/tvGameOver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvGameOver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/game_over"
            android:textColor="@color/brand_red"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/btnRestartGameOver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivGameOverIcon" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestartGameOver"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:layout_marginTop="40dp"
            android:text="@string/restart"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@color/brand_red"
            app:cornerRadius="32dp"
            app:icon="@android:drawable/ic_menu_rotate"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGameOver" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Level Complete Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlayLevelComplete"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_win"
        android:elevation="20dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/ivWinIcon"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/brand_gold"
            android:contentDescription="@string/level_complete"
            app:layout_constraintBottom_toTopOf="@id/tvLevelComplete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvLevelComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/level_complete"
            android:textColor="@color/brand_blue"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvCompleteInfo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivWinIcon" />

        <TextView
            android:id="@+id/tvCompleteInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@id/tvStars"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLevelComplete"
            tools:text="Level 3 - Medium" />

        <TextView
            android:id="@+id/tvStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/brand_gold"
            android:textSize="56sp"
            app:layout_constraintBottom_toTopOf="@id/btnNextLevel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCompleteInfo"
            tools:text="⭐⭐⭐" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextLevel"
            android:layout_width="260dp"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:text="@string/next_level"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:backgroundTint="@color/brand_blue"
            app:cornerRadius="32dp"
            app:icon="@android:drawable/ic_media_next"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toTopOf="@id/btnRestartComplete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStars" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestartComplete"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/restart"
            android:textAllCaps="false"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            app:backgroundTint="@color/brand_slate_50"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnNextLevel"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
